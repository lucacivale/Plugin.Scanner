<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetVersion);$(NetVersion)-ios;$(NetVersion)-android</TargetFrameworks>
        <NoWarn>DNAA0001</NoWarn>
		<PackageTags>dotnet; avalonia; barcode; scanner;</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="$(TargetFramework) == '$(NetVersion)-android'">
		<PackageReference Include="Avalonia.Android" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework) == '$(NetVersion)-ios'">
		<PackageReference Include="Avalonia.iOS" />
	</ItemGroup>
	
	<ItemGroup Condition="$(TargetFramework) == '$(NetVersion)'">
		<PackageReference Include="Avalonia" />
	</ItemGroup>

	<ItemGroup>
      <ProjectReference Include="..\Plugin.Scanner\Plugin.Scanner.csproj" />
	</ItemGroup>
</Project>
